# Copy to .env and fill in. Never commit real credentials.
# Replace password with the password of the local "postgres" user.
DATABASE_URL="postgresql://postgres:password@localhost:5432/orbyn?schema=public"

# Signs the Auth.js session cookie. 32+ random characters, e.g. `openssl rand -base64 32`.
# (AUTH_SECRET is also accepted and takes priority if both are set.)
SESSION_SECRET=""

# Optional: "Continue with Google". Leave both empty to hide the button.
# Create an OAuth client at https://console.cloud.google.com/apis/credentials with the redirect URI
# <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Gemini (https://aistudio.google.com -> Get API key)
GOOGLE_GENERATIVE_AI_API_KEY=""

# PayPal Sandbox (Day 2)
PAYPAL_ENV="sandbox"
PAYPAL_BASE_URL="https://api-m.sandbox.paypal.com"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""

CRON_SECRET=""
# Public base URL. Used for pay links and password-reset links.
APP_URL="http://localhost:3000"

# HMAC key that binds agent tool approvals to this server (32+ random bytes)
TOOL_APPROVAL_SECRET=""
GEMINI_MODEL="gemini-flash-latest"
