// Orbyn data model.
// Money is always stored as integer minor units (cents) in *Minor columns.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum OrderStatus {
  CREATED
  APPROVED
  COMPLETED
  VOIDED
  FAILED
}

enum TxnStatus {
  PENDING
  COMPLETED
  DENIED
  REFUNDED
}

// Where a record came from. SEEDED rows are demo data and are labelled in the UI;
// only PAYPAL_SANDBOX transactions represent real sandbox captures.
enum DataSource {
  USER
  AGENT
  SEEDED
  PAYPAL_SANDBOX
}

enum ReminderStatus {
  DRAFT
  SCHEDULED
  DUE
  SENT
  CANCELLED
}

model User {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  businessName    String?
  defaultCurrency String   @default("USD")
  createdAt       DateTime @default(now())

  clients       Client[]
  invoices      Invoice[]
  transactions  Transaction[]
  conversations AgentConversation[]
  auditLogs     AuditLog[]
}

model Client {
  id        String     @id @default(cuid())
  userId    String
  name      String
  email     String?
  company   String?
  source    DataSource @default(USER)
  createdAt DateTime   @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@unique([userId, name])
  @@index([userId])
}

model Invoice {
  id            String        @id @default(cuid())
  userId        String
  clientId      String
  invoiceNumber String
  description   String?
  currency      String        @default("USD")
  subtotalMinor Int
  taxRateBps    Int           @default(0)
  taxMinor      Int           @default(0)
  totalMinor    Int
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime      @default(now())
  dueDate       DateTime
  paidAt        DateTime?
  publicToken   String        @unique
  source        DataSource    @default(USER)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  client       Client         @relation(fields: [clientId], references: [id])
  items        InvoiceItem[]
  orders       PaymentOrder[]
  transactions Transaction[]
  reminders    Reminder[]

  @@unique([userId, invoiceNumber])
  @@index([userId, status])
  @@index([userId, dueDate])
}

model InvoiceItem {
  id             String @id @default(cuid())
  invoiceId      String
  description    String
  quantity       Int
  unitPriceMinor Int
  totalMinor     Int
  position       Int    @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model PaymentOrder {
  id            String      @id @default(cuid())
  invoiceId     String
  paypalOrderId String      @unique
  amountMinor   Int
  currency      String
  status        OrderStatus @default(CREATED)
  requestId     String      @unique // PayPal-Request-Id used when creating the order
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Transaction {
  id            String     @id @default(cuid())
  userId        String
  invoiceId     String?
  paypalOrderId String?
  captureId     String?    @unique // null only for SEEDED rows; prevents duplicate captures
  amountMinor   Int
  currency      String
  status        TxnStatus
  source        DataSource
  payerEmail    String?
  raw           Json?
  createdAt     DateTime   @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([invoiceId])
}

model Reminder {
  id          String         @id @default(cuid())
  invoiceId   String
  message     String
  tone        String         @default("polite")
  scheduledAt DateTime
  sentAt      DateTime?
  status      ReminderStatus @default(DRAFT)
  createdAt   DateTime       @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@index([invoiceId])
}

model AgentConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("New conversation")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AgentMessage[]

  @@index([userId, updatedAt])
}

// One row per AI SDK UIMessage. The server is the source of truth for history:
// clients only ever submit their newest message, so tool approvals cannot be forged.
model AgentMessage {
  id             String   @id // UIMessage id
  conversationId String
  role           String // user | assistant
  message        Json // full UIMessage (parts, tool calls, approvals, outputs)
  position       Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, position])
}

model WebhookEvent {
  id          String    @id // PayPal event id, used for de-duplication
  eventType   String
  resourceId  String?
  verified    Boolean
  processedAt DateTime?
  payload     Json
  createdAt   DateTime  @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  actor      String // user | agent | paypal_webhook | cron | system
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([entityType, entityId])
}
