// Orbyn data model.
// Money is always stored as integer minor units (cents) in *Minor columns.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum OrderStatus {
  CREATED
  APPROVED
  COMPLETED
  VOIDED
  FAILED
}

enum TxnStatus {
  PENDING
  COMPLETED
  DENIED
  REFUNDED
}

// Where a record came from. SEEDED rows are demo data and are labelled in the UI;
// only PAYPAL_SANDBOX transactions represent real sandbox captures.
enum DataSource {
  USER
  AGENT
  SEEDED
  PAYPAL_SANDBOX
}

enum ReminderStatus {
  DRAFT
  SCHEDULED
  DUE
  SENT
  CANCELLED
}

// A person who can sign in. Guests are created by "Try the live demo" and have no password.
model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  passwordHash    String? // argon2id; null for guests and Google-only accounts
  googleId        String?   @unique
  isGuest         Boolean   @default(false)
  role            String?
  onboardedAt     DateTime?
  tourDismissedAt DateTime?
  createdAt       DateTime  @default(now())

  workspace   Workspace?
  sessions    Session[]
  resetTokens PasswordResetToken[]
  auditLogs   AuditLog[]
}

// All business data hangs off a workspace. One owner per workspace; there are no invites yet.
model Workspace {
  id        String   @id @default(cuid())
  ownerId   String   @unique
  name      String
  currency  String   @default("USD")
  timezone  String   @default("UTC")
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())

  owner         User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  clients       Client[]
  invoices      Invoice[]
  transactions  Transaction[]
  conversations AgentConversation[]
  auditLogs     AuditLog[]
}

// One row per signed-in browser. The Auth.js JWT carries this id; deleting the row signs that browser out.
model Session {
  id         String   @id @default(cuid())
  userId     String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Only the SHA-256 of the token is stored. Single use, 30 minute expiry.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Fixed-window counters for login, signup and reset attempts.
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

model Client {
  id        String     @id @default(cuid())
  workspaceId    String
  name      String
  email     String?
  company   String?
  source    DataSource @default(USER)
  createdAt DateTime   @default(now())

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model Invoice {
  id            String        @id @default(cuid())
  workspaceId        String
  clientId      String
  invoiceNumber String
  description   String?
  currency      String        @default("USD")
  subtotalMinor Int
  taxRateBps    Int           @default(0)
  taxMinor      Int           @default(0)
  totalMinor    Int
  // Sum of COMPLETED captures. Kept in step with Transaction rows inside the same DB transaction.
  amountPaidMinor Int         @default(0)
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime      @default(now())
  dueDate       DateTime
  paidAt        DateTime?
  publicToken   String        @unique
  source        DataSource    @default(USER)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  workspace         Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client       Client         @relation(fields: [clientId], references: [id])
  items        InvoiceItem[]
  orders       PaymentOrder[]
  transactions Transaction[]
  reminders    Reminder[]

  @@unique([workspaceId, invoiceNumber])
  @@index([workspaceId, status])
  @@index([workspaceId, dueDate])
}

model InvoiceItem {
  id             String @id @default(cuid())
  invoiceId      String
  description    String
  quantity       Int
  unitPriceMinor Int
  totalMinor     Int
  position       Int    @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model PaymentOrder {
  id            String      @id @default(cuid())
  invoiceId     String
  paypalOrderId String      @unique
  amountMinor   Int
  currency      String
  status        OrderStatus @default(CREATED)
  requestId     String      @unique // PayPal-Request-Id used when creating the order
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Transaction {
  id            String     @id @default(cuid())
  workspaceId        String
  invoiceId     String?
  paypalOrderId String?
  captureId     String?    @unique // null only for SEEDED rows; prevents duplicate captures
  amountMinor   Int
  // Sum of COMPLETED refunds against this capture. status becomes REFUNDED when it reaches amountMinor.
  refundedMinor Int        @default(0)
  currency      String
  status        TxnStatus
  source        DataSource
  payerEmail    String?
  raw           Json?
  createdAt     DateTime   @default(now())

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  refunds Refund[]

  @@index([workspaceId, createdAt])
  @@index([invoiceId])
}

enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
}

model Refund {
  id             String       @id @default(cuid())
  transactionId  String
  paypalRefundId String       @unique // prevents the same refund being counted twice
  amountMinor    Int
  currency       String
  status         RefundStatus
  reason         String?
  createdAt      DateTime     @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
}

model Reminder {
  id          String         @id @default(cuid())
  invoiceId   String
  message     String
  tone        String         @default("polite")
  scheduledAt DateTime
  sentAt      DateTime?
  status      ReminderStatus @default(DRAFT)
  createdAt   DateTime       @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@index([invoiceId])
}

model AgentConversation {
  id        String   @id @default(cuid())
  workspaceId    String
  title     String   @default("New conversation")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace     Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages AgentMessage[]

  @@index([workspaceId, updatedAt])
}

// One row per AI SDK UIMessage. The server is the source of truth for history:
// clients only ever submit their newest message, so tool approvals cannot be forged.
model AgentMessage {
  id             String   @id // UIMessage id
  conversationId String
  role           String // user | assistant
  message        Json // full UIMessage (parts, tool calls, approvals, outputs)
  position       Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, position])
}

model WebhookEvent {
  id          String    @id // PayPal event id, used for de-duplication
  eventType   String
  resourceId  String?
  verified    Boolean
  processedAt DateTime?
  payload     Json
  createdAt   DateTime  @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  workspaceId String?
  userId     String? // the signed-in person, when there was one
  actor      String // user | agent | paypal_webhook | cron | system
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([entityType, entityId])
}
